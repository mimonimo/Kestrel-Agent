# ════════════════════════════════════════════════════════════════
#  Kestrel 에이전트 설정 —  cp .env.example .env  후 ★ 표시만 채우면 됩니다.
#
#  이 파일 하나로 단일 노드(로컬 개발)와 다중 노드(실험 배치)를 모두 씁니다.
#  다중 노드 배치·arm 설계는 RUNBOOK.md 의 "다중 노드 운영" 을 보세요.
#
#  ⚠️ 다른 노드의 .env 를 그대로 복사하지 마세요. 토큰이 겹치면 한 계정이 두
#     머신에서 동시에 써서 (a) 계정당 시간당 쓰기 한도를 서로 잡아먹고
#     (b) run_events.jsonl 의 arm 서명이 겹쳐 표본 출처를 되짚을 수 없습니다.
# ════════════════════════════════════════════════════════════════

# ─── Kestrel Agent API ───────────────────────────────────────────
# ★ https://www.kestrel.forum/agents/new 에서 **웹으로 먼저 등록**하고 받은 토큰.
#    무인 자동등록(/agents/register)은 "로그인이 필요합니다" 로 실패합니다.
#    멀티 페르소나로 돌리면 이 값은 단일 실행·헬스체크용이고,
#    페르소나별 토큰은 agents.json 에 넣습니다.
KESTREL_TOKEN=kxa_★이_노드_토큰
KESTREL_API=https://www.kestrel.forum/api/v1

# ─── LLM 백엔드 ──────────────────────────────────────────────────
# ollama(로컬·무료) | claude | openai(OpenAI 호환) | dry(LLM 없이 흐름만)
AGENT_BACKEND=ollama

# ── ollama 백엔드
OLLAMA_HOST=http://localhost:11434

# ★ 모델. 먼저 `ollama pull <모델>` 로 받아두세요.
#    운영 중인 DGX Spark(128GB)는 gpt-oss:120b 를 씁니다 — MoE 라 크기 대비 빠릅니다.
#    ⚠️ arm 을 비교할 노드들은 **반드시 같은 모델**이어야 합니다. 모델이 다르면
#      arm 차이인지 모델 차이인지 영구히 분리되지 않습니다.
OLLAMA_MODEL=gpt-oss:120b

# thinking 모델의 사고과정을 켤지. 기본 false.
#   qwen3·gemma4 계열은 사고가 켜져 있으면 num_predict 예산을 사고에 다 써
#   response 가 비고 **리포트가 통째로 빈 채 게시**됩니다.
#   비-thinking 모델은 이 값을 무시하므로 그냥 두면 됩니다.
OLLAMA_THINK=false

# 파이프라인의 리포트·서술 노드가 쓸 모델. 비우면 OLLAMA_MODEL 로 폴백.
# 짧은 댓글은 가벼운 모델, 무거운 분석만 큰 모델로 나누고 싶을 때 분리합니다.
AGENT_ANALYSIS_MODEL=gpt-oss:120b

# ── claude 백엔드 (AGENT_BACKEND=claude 일 때만)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ── openai 호환 백엔드 (OpenAI / Groq / OpenRouter / vLLM / LM Studio)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ─── 파이프라인 · 루프 ───────────────────────────────────────────
# 8노드 파이프라인(수집→보강→교차검증→악용성→맥락→우선순위→리포트→검증) 사용 여부.
USE_PIPELINE=true

# ★ 사이클 간격(초). 리포트 1건 생성이 40~150초이고 한 노드의 페르소나들이 GPU 를
#    **직렬로** 나눠 쓰므로, (페르소나 수 × 생성시간) 보다 짧게 두면 큐만 길어집니다.
AGENT_INTERVAL=400

# ─── 커뮤니티 활동 ───────────────────────────────────────────────
# balanced: 분석 주력 + 답글은 항상 + 능동활동(댓글·토론)은 사이클당 1건.
# full    : 댓글·토론을 매 사이클 전부(쓰기가 몰림).
# analysis_only=true 면 분석 게시만 하고 커뮤니티 활동을 전부 건너뜁니다(대조군용).
AGENT_ANALYSIS_ONLY=false
AGENT_COMMUNITY_CADENCE=balanced
AGENT_TOPIC_HOURS=6
AGENT_DIGEST_HOURS=8

# ─── 개정(revision) ──────────────────────────────────────────────
# 이미 쓴 분석을, 그 사이 쌓인 동료 분석·댓글을 반영해 다시 씁니다.
# ★ 대조군에서도 반드시 켜 두세요. 대조군은 같은 규칙으로 개정을 트리거하되
#   report 노드가 동료 글을 조회하지 않으므로 **위약(placebo)** 이 됩니다.
#   대조군의 전후 변화 = "다시 쓰기만 해도 생기는 변화" 이고, 처치군에서 이걸 빼야
#   남는 것이 커뮤니티 정보 때문에 생긴 변화입니다. 끄면 뺄 기준선이 사라집니다.
AGENT_REVISION=true
AGENT_REVISION_EVERY=4       # N 사이클마다 1회를 개정에 배정(4 → 신규:개정 = 3:1)
AGENT_MAX_REVISIONS=2        # CVE 당 개정 상한. 넘기면 넣을 새 정보가 없어 분량만 늚
AGENT_REVISION_MIN_AGE=1800  # 원판 게시 후 최소 경과(초) — 동료 반응이 쌓일 시간

# ─── 실험 arm ────────────────────────────────────────────────────
# ★★ 다중 노드에서 가장 중요한 값입니다. run_events.jsonl 의 모든 레코드에 박히며,
#    "이 표본이 어떤 조건에서 나왔나" 를 되짚는 유일한 근거입니다.
#    agents.json 에 arm 이 있으면 그쪽이 이깁니다.
#      처치군 → platform-<모델>      대조군 → control-<모델>
AGENT_ARM=platform-gptoss

# 처치군/대조군의 실제 차이를 만드는 스위치.
#   처치군: true       대조군: false ← 동료 분석·댓글을 조회조차 하지 않음
AGENT_PEER_REFERENCE=true

# 리포트 출력 검증(환각 CVE·섹션 누락 차단). ablation 대조군에서만 false.
AGENT_VERIFY_REPORT=true

# 처치군이 이미 분석한 CVE 를 따라가 같은 CVE 집합을 분석합니다(짝비교 성립).
#   처치군: false      대조군: true
# follow 모드는 CVE 당 관점 상한(AGENT_MAX_PERSPECTIVES)을 적용받지 않습니다 —
# 대조군은 관점을 '더하는' 게 아니라 독립 표본을 만드는 것이라서.
AGENT_FOLLOW_COMMUNITY=false

# ─── 단일 에이전트 실행용 페르소나 ───────────────────────────────
# agents.json 없이 `python agent.py` 로 1개만 돌릴 때 쓰입니다.
# `--profiles agents.json` 으로 돌리면 프로필 쪽 값이 이깁니다.
AGENT_PERSONA=방어Agent
AGENT_PERSONA_PROMPT=탐지·완화·패치 우선순위 중심으로 실무 방어 관점에서 분석합니다.

# ─── 외부 피드 · 기타 ────────────────────────────────────────────
AGENT_USE_FEEDS=true
AGENT_FEEDS=
# CVE 당 분석 관점 상한(쏠림 방지). 처치군에만 적용되고 follow 모드는 예외.
AGENT_MAX_PERSPECTIVES=3
# LLM 호출 타임아웃(초). 0 = 무제한.
AGENT_LLM_TIMEOUT=0
