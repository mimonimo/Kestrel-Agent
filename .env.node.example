# ════════════════════════════════════════════════════════════════
#  추가 DGX 노드용 .env 예시  →  복사해서 `.env` 로 쓰세요
#     cp .env.node.example .env    후 ★ 표시된 곳만 채우면 됩니다.
#
#  ⚠️ 기존 노드의 .env 를 그대로 복사하지 마세요. 같은 토큰이면 한 계정이
#     두 머신에서 동시에 글을 써서 (a) 계정당 시간당 쓰기 한도를 서로 잡아먹고
#     (b) run_events.jsonl 의 arm 서명이 겹쳐 표본 출처를 되짚을 수 없게 됩니다.
#
#  ── 2~3 노드 권장 배치 ───────────────────────────────────────────
#   노드 A (기존 spark-1397)  처치군 3페르소나  AGENT_ARM=platform
#   노드 B (신규)            대조군 3페르소나  AGENT_ARM=control
#   노드 C (있으면)          아래 셋 중 택1 — 이 파일 맨 아래 [노드 C] 참고
#
#   왜 대조군을 통째로 다른 노드에 두는가:
#   지금은 대조군 1개가 처치군 3개와 같은 GPU 를 직렬로 나눠 쓴다. 짝비교는
#   처치군 분석 1건당 대조군 1건이 있어야 성립하는데, 대조군 산출이 1/4 이라
#   **짝의 수를 대조군이 혼자 제한**하고 있다. 노드를 나누면 이 병목이 사라진다.
#   덤으로 대조군에 3페르소나를 다 둘 수 있어(지금은 analyst 렌즈 하나뿐)
#   arm 비교가 페르소나 완전 매칭이 된다 — 지금까지 결과를 뒤집었던 그 교란이
#   설계 단계에서 원천 제거된다.
# ════════════════════════════════════════════════════════════════

# ─── Kestrel API ────────────────────────────────────────────────
# ★ 이 노드에서 쓸 계정 토큰. https://www.kestrel.forum/agents/new 에서 **웹으로 먼저 등록**.
#    무인 자동등록(/agents/register)은 "로그인이 필요합니다" 로 실패합니다.
#    멀티 페르소나로 돌리면 이 값은 단일 실행/헬스체크용이고,
#    실제 페르소나별 토큰은 agents.json 에 넣습니다.
KESTREL_TOKEN=kxa_★이_노드_토큰
KESTREL_API=https://www.kestrel.forum/api/v1

# ─── LLM 백엔드 ──────────────────────────────────────────────────
AGENT_BACKEND=ollama
OLLAMA_HOST=http://localhost:11434

# ★ 모델. 먼저 `ollama pull <모델>` 로 받아두세요.
#    ⚠️ arm 을 비교할 두 노드(처치군/대조군)는 **반드시 같은 모델**이어야 합니다.
#      모델이 다르면 arm 차이인지 모델 차이인지 영구히 분리되지 않습니다.
#      모델을 바꿔보고 싶다면 그건 노드 C 의 역할입니다(맨 아래 참고).
OLLAMA_MODEL=gemma4:31b

# ⚠️ thinking 모델이면 절대 true 로 두지 마세요.
#    qwen3 / gemma4 계열은 think 가 켜져 있으면 num_predict 예산을 사고과정에 다 쓰고
#    response 가 비어 **리포트가 통째로 빈 채 게시**됩니다. 비-thinking 모델은 이 값을 무시.
OLLAMA_THINK=false

# 계층2 파이프라인의 리포트/서술 노드가 쓰는 모델. 비우면 OLLAMA_MODEL 로 폴백.
# 짧은 댓글은 가벼운 모델, 무거운 분석만 큰 모델로 나누고 싶을 때 여기서 분리합니다.
AGENT_ANALYSIS_MODEL=gemma4:31b

# ─── 파이프라인 · 루프 ───────────────────────────────────────────
USE_PIPELINE=true

# ★ 사이클 간격(초). GPU 성능에 맞춰 조정.
#    리포트 1건 생성이 ~150~200초이고 페르소나들이 GPU 를 **직렬로** 나눠 쓰므로,
#    (페르소나 수 × 리포트 생성시간) 보다 짧게 두면 큐만 길어지고 처리량은 안 늘어납니다.
#    새 노드가 더 빠른 GPU 면 이 값을 줄여 표본을 늘릴 수 있습니다.
AGENT_INTERVAL=400

# ─── 커뮤니티 활동 ───────────────────────────────────────────────
# balanced: 분석 주력 + 답글은 항상 + 능동활동(댓글/토론)은 사이클당 1건.
# full    : 댓글·토론을 매 사이클 전부(쓰기가 몰림).
# ★ 대조군 노드(B)라면 agents.json 에서 analysisOnly=true 로 덮이므로 이 값은 무시됩니다.
AGENT_ANALYSIS_ONLY=false
AGENT_COMMUNITY_CADENCE=balanced
AGENT_TOPIC_HOURS=6
AGENT_DIGEST_HOURS=8

# ─── 개정(revision) ──────────────────────────────────────────────
# 이미 쓴 분석을, 그 사이 쌓인 동료 분석·댓글을 반영해 다시 씁니다.
# ★ 대조군 노드에서도 반드시 켜 두세요. 대조군은 같은 규칙으로 개정을 트리거하되
#   report 노드가 동료 글을 아예 조회하지 않으므로 **위약(placebo)** 이 됩니다.
#   대조군의 전후 변화 = "다시 쓰기만 해도 생기는 변화" 이고, 처치군에서 이걸 빼야
#   남는 것이 커뮤니티 정보 때문에 생긴 변화입니다. 대조군에서 끄면 뺄 값이 사라집니다.
AGENT_REVISION=true
AGENT_REVISION_EVERY=4       # N 사이클마다 1회를 개정에 배정(4 → 신규:개정 = 3:1)
AGENT_MAX_REVISIONS=2        # CVE 당 개정 상한. 넘기면 넣을 새 정보가 없어 분량만 부풀음
AGENT_REVISION_MIN_AGE=1800  # 원판 게시 후 최소 경과(초) — 동료 반응이 쌓일 시간

# ─── 실험 arm 서명 ───────────────────────────────────────────────
# ★★ 다중 노드에서 가장 중요한 값입니다.
#    run_events.jsonl 의 모든 레코드에 박히며, 나중에 "이 표본이 어떤 조건에서
#    나왔나" 를 되짚는 유일한 근거입니다. agents.json 에 arm 이 있으면 그쪽이 이깁니다.
#
#      노드 A → platform      노드 B → control      노드 C → 아래 참고
AGENT_ARM=control

# 처치군/대조군의 실제 차이를 만드는 스위치.
#   노드 A(처치군): AGENT_PEER_REFERENCE=true
#   노드 B(대조군): AGENT_PEER_REFERENCE=false  ← 동료 분석·댓글을 조회조차 하지 않음
AGENT_PEER_REFERENCE=false
AGENT_VERIFY_REPORT=true

# 처치군이 이미 분석한 CVE 를 따라가 같은 CVE 집합을 분석하게 합니다(짝비교 성립).
#   노드 A(처치군): false      노드 B(대조군): true
# follow 모드는 CVE 당 관점 상한(AGENT_MAX_PERSPECTIVES)을 적용받지 않습니다 —
# 대조군은 커뮤니티에 관점을 '더하는' 게 아니라 독립 표본을 만드는 것이라서.
AGENT_FOLLOW_COMMUNITY=true

# ─── 단일 에이전트 실행용 페르소나 ───────────────────────────────
# agents.json 없이 `python3 agent.py` 로 1개만 돌릴 때 쓰이는 값.
# `--profiles agents.json` 으로 돌리면 프로필 쪽 값이 이깁니다.
AGENT_PERSONA=방어Agent
AGENT_PERSONA_PROMPT=탐지·완화·패치 우선순위 중심으로 실무 방어 관점에서 분석합니다.

# ─── 외부 피드 · 기타 ────────────────────────────────────────────
AGENT_USE_FEEDS=true
AGENT_FEEDS=
# CVE 당 분석 관점 상한(쏠림 방지). 처치군에만 적용되고 follow 모드는 예외.
AGENT_MAX_PERSPECTIVES=3
AGENT_LLM_TIMEOUT=0

# ════════════════════════════════════════════════════════════════
#  [노드 C] 세 번째 노드가 있을 때 — 셋 중 하나를 고르세요
#
#  ① 표본 증설 (가장 안전)
#     노드 A 와 완전히 동일한 설정 + 새 계정 3개. AGENT_ARM=platform 그대로.
#     처치군 표본이 두 배가 되어 짝비교 검정력이 올라갑니다. 새로 배울 건 없지만
#     지금 p 값이 아슬아슬한 지표들을 확정지을 수 있습니다.
#
#  ② 모델 강건성 검증 (논문에 가장 강함)
#     처치군 구성 그대로, OLLAMA_MODEL 만 다른 모델로.  AGENT_ARM=platform-<모델명>
#     "협업 효과가 특정 모델의 성질이 아니다" 를 보이는 robustness check 입니다.
#     ⚠️ 이 노드의 표본은 노드 A 와 **절대 합치지 마세요** — 반드시 arm 을 분리.
#
#  ③ ablation (개정 기능의 순효과)
#     노드 A 와 동일 + AGENT_REVISION=false,  AGENT_ARM=platform-norev
#     개정 루프가 없을 때 협업 효과가 얼마나 줄어드는지를 직접 보여줍니다.
#
#  추천: 대조군 표본이 아직 얇으므로 ①→② 순. 여유가 있으면 ② 가 포스터에서 가장 셉니다.
# ════════════════════════════════════════════════════════════════
